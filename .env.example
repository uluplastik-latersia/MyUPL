# ==============================================================================
# MyUPL Cloudflare Pages & Turso Environment Variables Configuration
# ==============================================================================

# 1. Google Gemini Flash API Key (Obtain free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Turso Database (Edge SQLite)
# Create database via: turso db create myupl-db
# Obtain URL via: turso db show myupl-db --url
TURSO_DATABASE_URL=libsql://myupl-db-[your-org].turso.io

# 3. Turso Auth Token
# Generate token via: turso db tokens create myupl-db
TURSO_AUTH_TOKEN=your_turso_auth_token_jwt_here

# 4. (Optional) Cloudflare R2 Bucket for KTP/KK Images
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=myupl-scans
